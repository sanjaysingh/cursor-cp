# Cursor API Key (required)
# Get from https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=your_cursor_api_key_here

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Server Configuration
PORT=8080
HOST=0.0.0.0

# Workspace (cloned repos / agent cwd)
WORKSPACE_ROOT=~/cursor-cp/ws-root

# Project home layout (default: ~/cursor-cp/)
#   ws-root/  repositories
#   logs/     daily JSON logs
#   data/     SQLite DB and service metadata
# CURSOR_CP_HOME=~/cursor-cp

# Logging (optional)
# Daily JSON logs: logs/cursor-cp-YYYY-MM-DD.log under project home
# Set LOG_FILE=false to disable file logging (console only).
# LOG_FILE=
# CURSOR_CP_LOG_FILE=
# LOG_LEVEL=info
# CURSOR_CP_DB_PATH=

# GitHub CLI (optional, for repo operations)
# Ensure 'gh' is installed and authenticated
