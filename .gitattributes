# Normalize line endings: LF in the repo, auto-converted on checkout.
* text=auto eol=lf

# Shell scripts must always use LF, even on Windows checkouts.
*.sh text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no normalization).
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
